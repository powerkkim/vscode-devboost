{
  "name": "devboost",
  "displayName": "DevBoost",
  "description": "개발 편의 기능 모음 — 통합 검색(Search Everywhere), MyBatis SQL 실행, DB 스키마·테이블 정의서 등. 기능별로 켜고 끌 수 있음",
  "version": "0.9.0",
  "publisher": "powerkkim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/powerkkim/vscode-devboost.git"
  },
  "bugs": {
    "url": "https://github.com/powerkkim/vscode-devboost/issues"
  },
  "homepage": "https://github.com/powerkkim/vscode-devboost#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devBoost.searchEverywhere.open",
        "title": "모두",
        "category": "Search Everywhere"
      },
      {
        "command": "devBoost.searchEverywhere.classes",
        "title": "클래스",
        "category": "Search Everywhere"
      },
      {
        "command": "devBoost.searchEverywhere.files",
        "title": "파일",
        "category": "Search Everywhere"
      },
      {
        "command": "devBoost.searchEverywhere.symbols",
        "title": "심볼",
        "category": "Search Everywhere"
      },
      {
        "command": "devBoost.searchEverywhere.actions",
        "title": "액션",
        "category": "Search Everywhere"
      },
      {
        "command": "devBoost.searchEverywhere.text",
        "title": "텍스트",
        "category": "Search Everywhere"
      },
      {
        "command": "devBoost.sourceAtlas.open",
        "title": "Atlas 화면 열기 (열린 .vue 기준)",
        "category": "Source Atlas"
      },
      {
        "command": "devBoost.sourceAtlas.dump",
        "title": "분석 결과 JSON 보기 (열린 .vue 기준)",
        "category": "Source Atlas"
      },
      {
        "command": "devBoost.mybatisRunner.open",
        "title": "SQL 실행 화면 열기 (커서 위치 쿼리)",
        "category": "MyBatis",
        "icon": "$(play)"
      },
      {
        "command": "devBoost.mybatisRunner.copy",
        "title": "SQL 복사 (마지막 입력값)",
        "category": "MyBatis"
      },
      {
        "command": "devBoost.dbSchema.open",
        "title": "스키마 가져오기 · 테이블 정의서",
        "category": "DB 스키마",
        "icon": "$(database)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devBoost.sidebar",
          "title": "DevBoost",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "devBoost.sidebar": [
        {
          "type": "webview",
          "id": "devBoost.searchEverywhere.sidebar",
          "name": "Search Everywhere",
          "when": "config.devBoost.searchEverywhere.enabled && devBoost.searchEverywhere.panelUi"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "devBoost.searchEverywhere.open",
          "when": "config.devBoost.searchEverywhere.enabled"
        },
        {
          "command": "devBoost.searchEverywhere.classes",
          "when": "config.devBoost.searchEverywhere.enabled"
        },
        {
          "command": "devBoost.searchEverywhere.files",
          "when": "config.devBoost.searchEverywhere.enabled"
        },
        {
          "command": "devBoost.searchEverywhere.symbols",
          "when": "config.devBoost.searchEverywhere.enabled"
        },
        {
          "command": "devBoost.searchEverywhere.actions",
          "when": "config.devBoost.searchEverywhere.enabled"
        },
        {
          "command": "devBoost.searchEverywhere.text",
          "when": "config.devBoost.searchEverywhere.enabled"
        },
        {
          "command": "devBoost.sourceAtlas.open",
          "when": "config.devBoost.sourceAtlas.enabled && resourceExtname == .vue"
        },
        {
          "command": "devBoost.sourceAtlas.dump",
          "when": "config.devBoost.sourceAtlas.enabled && resourceExtname == .vue"
        },
        {
          "command": "devBoost.mybatisRunner.open",
          "when": "config.devBoost.mybatisRunner.enabled && resourceExtname == .xml"
        },
        {
          "command": "devBoost.mybatisRunner.copy",
          "when": "config.devBoost.mybatisRunner.enabled && resourceExtname == .xml"
        },
        {
          "command": "devBoost.dbSchema.open",
          "when": "config.devBoost.dbSchema.enabled"
        }
      ],
      "editor/context": [
        {
          "command": "devBoost.sourceAtlas.open",
          "when": "config.devBoost.sourceAtlas.enabled && resourceExtname == .vue",
          "group": "navigation@99"
        },
        {
          "command": "devBoost.mybatisRunner.open",
          "when": "config.devBoost.mybatisRunner.enabled && resourceExtname == .xml",
          "group": "navigation@98"
        }
      ]
    },
    "keybindings": [
      {
        "command": "devBoost.searchEverywhere.open",
        "key": "shift shift",
        "mac": "shift shift",
        "when": "config.devBoost.searchEverywhere.enabled && config.devBoost.searchEverywhere.doubleShift"
      },
      {
        "command": "devBoost.searchEverywhere.open",
        "key": "ctrl+alt+shift+f",
        "mac": "cmd+alt+shift+f",
        "when": "config.devBoost.searchEverywhere.enabled"
      },
      {
        "command": "devBoost.mybatisRunner.open",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && config.devBoost.mybatisRunner.enabled && resourceExtname == .xml"
      }
    ],
    "configuration": [
      {
        "title": "DevBoost: 기능 켜기/끄기",
        "properties": {
          "devBoost.searchEverywhere.enabled": {
            "type": "boolean",
            "default": true,
            "order": 0,
            "markdownDescription": "**Search Everywhere** — 클래스·파일·심볼·텍스트 통합 검색 (`Shift` 두 번 / `Ctrl+Alt+Shift+F`)"
          },
          "devBoost.sourceAtlas.enabled": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "markdownDescription": "**Source Atlas** — 열린 Vue 파일의 컴포넌트·composable·store·API 관계를 Atlas 화면으로 분석 (에디터 우클릭 → Atlas 화면 열기)"
          },
          "devBoost.mybatisRunner.enabled": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "markdownDescription": "**MyBatis SQL 실행** — mapper XML 쿼리 위의 `▶ SQL 실행`으로 파라미터 값을 넣어 실행 가능한 SQL 을 만들고 Oracle 워크시트로 보냄 (`Ctrl+Alt+Enter`)"
          },
          "devBoost.dbSchema.enabled": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "markdownDescription": "**DB 스키마** — 수집 쿼리 결과를 가져와 테이블·컬럼·제약·인덱스 정보를 저장하고(`.devboost/schema`), 테이블 정의서(CSV: 목차 + 정의서)를 만듦. 명령: `DB 스키마: 스키마 가져오기 · 테이블 정의서`"
          }
        }
      },
      {
        "title": "Search Everywhere",
        "properties": {
          "devBoost.searchEverywhere.ui": {
            "type": "string",
            "enum": [
              "popup",
              "panel",
              "window",
              "quickPick"
            ],
            "enumDescriptions": [
              "검색 창을 에디터 탭으로 열기 (기본)",
              "왼쪽 Activity Bar의 DevBoost 사이드바 (Ctrl+Shift+F 검색처럼 독립 패널) — 끌어서 오른쪽/하단으로 옮길 수 있음",
              "검색 창을 별도 창으로 열기 — VS Code 창 틀(제목줄·탭줄)이 함께 표시됨",
              "VS Code 기본 QuickPick 목록 (코드 위 팝업, 가볍지만 모양이 다름)"
            ],
            "default": "popup",
            "description": "Search Everywhere 화면 방식"
          },
          "devBoost.searchEverywhere.panelKeepOpen": {
            "type": "boolean",
            "default": false,
            "description": "사이드바 방식에서 항목을 열거나 Esc를 눌러도 사이드바를 닫지 않고 그대로 둠"
          },
          "devBoost.searchEverywhere.showTiming": {
            "type": "boolean",
            "default": true,
            "description": "검색 창 하단에 단계별 소요 시간 표시 + 출력 패널 'DevBoost'에 기록"
          },
          "devBoost.searchEverywhere.doubleShift": {
            "type": "boolean",
            "default": true,
            "description": "Shift 키를 빠르게 두 번 눌러 Search Everywhere 열기"
          },
          "devBoost.searchEverywhere.maxResults": {
            "type": "number",
            "default": 50,
            "description": "탭별 최대 결과 개수"
          },
          "devBoost.searchEverywhere.defaultScope": {
            "type": "string",
            "enum": [
              "project",
              "projectAndLibs",
              "production",
              "test",
              "recentViewed",
              "recentChanged"
            ],
            "enumDescriptions": [
              "프로젝트 파일 (라이브러리·vendor 제외)",
              "프로젝트 및 라이브러리 (~/.m2, JDK, vendor 포함)",
              "프로젝트 프로덕션 파일 (src/test 등 테스트 제외)",
              "프로젝트 테스트 파일",
              "최근에 본 파일",
              "최근 변경된 파일 (Git 작업 트리)"
            ],
            "default": "project",
            "description": "검색 창을 열 때의 기본 범위"
          },
          "devBoost.searchEverywhere.fileMasks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "*.java, *mapper*.xml, *.properties, *.yml",
              "*.vue, *.ts, *.js",
              "*.java",
              "*mapper*.xml",
              "*.vue",
              "*.ts, *.js",
              "*.xml",
              "*.properties, *.yml, *.yaml",
              "*.sql",
              "*.html, *.jsp",
              "*.css, *.scss",
              "*.json",
              "*.md"
            ],
            "markdownDescription": "텍스트 탭 파일 타입 드롭다운에 보여줄 목록. 쉼표로 여러 패턴을 묶으면 그중 하나라도 맞는 파일을 검색합니다. `*`는 이름 어디에나 쓸 수 있고 대소문자는 구분하지 않습니다 (예: `*mapper*.xml` → `OrderMapper.xml`). 입력란에 직접 써도 됩니다."
          },
          "devBoost.searchEverywhere.exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "**/node_modules/**",
              "**/.git/**",
              "**/.svn/**",
              "**/target/**",
              "**/build/**",
              "**/out/**",
              "**/dist/**",
              "**/bin/**",
              "**/.gradle/**",
              "**/.mvn/**",
              "**/.idea/**",
              "**/.vscode/**",
              "**/.settings/**",
              "**/logs/**",
              "**/coverage/**",
              "**/.next/**",
              "**/.nuxt/**",
              "**/*.log"
            ],
            "markdownDescription": "**검색에서 완전히 뺄** 경로 (파일·텍스트·클래스·심볼 모든 탭에 적용). 빌드 결과물·캐시·로그처럼 볼 일이 없는 것. 텍스트 검색은 `.gitignore`도 자동 반영됩니다.\n\n라이브러리로 취급해 *프로젝트 및 라이브러리* 범위에서만 보고 싶은 것은 `library`에 넣으세요."
          },
          "devBoost.searchEverywhere.library": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "**/vendor/**",
              "**/vendors/**",
              "**/static/lib/**",
              "**/*.min.js",
              "**/*.min.css"
            ],
            "markdownDescription": "**라이브러리로 취급**할 경로 (bootstrap, fontawesome 등 프로젝트 안에 복사해 둔 외부 코드). 기본 범위(*프로젝트 파일*)에서는 안 보이고, 범위를 *프로젝트 및 라이브러리*로 바꾸면 보입니다.\n\n아예 검색하지 않으려면 `exclude`에 넣으세요."
          }
        }
      },
      {
        "title": "Source Atlas",
        "properties": {
          "devBoost.sourceAtlas.maxDepth": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "maximum": 10,
            "markdownDescription": "열린 파일에서 import 를 몇 단계까지 따라갈지"
          },
          "devBoost.sourceAtlas.aliases": {
            "type": "object",
            "default": {},
            "additionalProperties": {
              "type": "string"
            },
            "markdownDescription": "import alias 수동 지정 (vite.config / tsconfig 에서 자동으로 못 읽을 때). 예: `{ \"@\": \"src\" }` — 값은 워크스페이스 기준 경로"
          },
          "devBoost.sourceAtlas.maxUpDepth": {
            "type": "number",
            "default": 3,
            "minimum": 0,
            "maximum": 10,
            "markdownDescription": "열린 컴포넌트를 사용하는 **상위** 컴포넌트·라우트를 몇 단계까지 찾을지 (0 이면 끔)"
          },
          "devBoost.sourceAtlas.backend.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "워크스페이스에 Spring 컨트롤러가 있으면 API 호출 → Controller → Service → MyBatis SQL → 테이블까지 분석 (없으면 UI 의 API 호출까지만)"
          },
          "devBoost.sourceAtlas.backend.maxDepth": {
            "type": "number",
            "default": 6,
            "minimum": 1,
            "maximum": 12,
            "markdownDescription": "컨트롤러에서 Service/Mapper 를 몇 단계까지 따라갈지"
          }
        }
      },
      {
        "title": "MyBatis SQL 실행",
        "properties": {
          "devBoost.mybatisRunner.codeLens": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "mapper XML 의 각 쿼리 위에 `▶ SQL 실행` / `SQL 복사` 표시"
          },
          "devBoost.mybatisRunner.dimInactive": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "SQL 실행 화면이 열려 있는 동안, 현재 값으로 꺼진 `<if>`·`<when>` 을 XML 에서 흐리게 표시"
          },
          "devBoost.mybatisRunner.worksheetInsert": {
            "type": "string",
            "enum": [
              "append",
              "replace"
            ],
            "enumDescriptions": [
              "워크시트 끝에 이어 붙이고 그 부분을 선택",
              "워크시트 내용을 바꿈"
            ],
            "default": "append",
            "markdownDescription": "Oracle 워크시트로 보낼 때 기존 내용 처리. 보낼 곳은 마지막으로 사용한 Oracle 워크시트(접속에서 `Open SQL Worksheet` 로 연 것)이고, 없으면 새 워크시트를 엽니다"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./ --noEmit && tsc -p tsconfig.webview.json && node esbuild.mjs --production",
    "compile": "tsc -p ./ && tsc -p tsconfig.webview.json && node esbuild.mjs",
    "build": "tsc -p ./ --noEmit && tsc -p tsconfig.webview.json && node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"test/**/*.test.js\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.11",
    "@dagrejs/dagre": "^3.1.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue/compiler-sfc": "^3.5.44",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0",
    "vue": "^3.5.44"
  },
  "keywords": [
    "search",
    "search everywhere",
    "find file",
    "find class",
    "java",
    "spring",
    "vue",
    "ripgrep",
    "mybatis",
    "oracle",
    "sql",
    "table definition",
    "schema"
  ]
}
